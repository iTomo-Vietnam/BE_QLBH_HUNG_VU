{
  "name": "backend-qlbh",
  "version": "1.0.0",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://opensource.org/license/isc-license-txt"
    }
  ],
  "description": "Backend QLBH",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev-nodemon": "nodemon --exec ts-node --files -r tsconfig-paths/register src/index.ts",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "start": "node -r tsconfig-paths/register dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
    "db:migrate:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/config/database.ts",
    "db:migrate:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/config/database.ts",
    "db:sync": "ts-node -r tsconfig-paths/register src/database/function/schema-sync.ts",
    "db:reset": "ts-node -r tsconfig-paths/register src/database/function/schema-drop-sync.ts",
    "db:drop": "ts-node -r tsconfig-paths/register src/database/function/schema-drop.ts",
    "db:check": "ts-node -r tsconfig-paths/register src/database/function/check-sync.ts",
    "db:create": "ts-node -r tsconfig-paths/register src/database/function/schema-from-entities.ts",
    "db:recreate": "ts-node -r tsconfig-paths/register src/database/function/schema-from-entities.ts --recreate",
    "db:generate": "./scripts/generate-schema.sh",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/seeders/index.ts",
    "db:seed:attribute": "ts-node -r tsconfig-paths/register src/database/seeders/attribute/index.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/database.ts",
    "validator:gen": "ts-node -r tsconfig-paths/register src/scripts/generate-validators-auto.ts",
    "validator:auto-gen": "ts-node -r tsconfig-paths/register src/scripts/generate-validators-auto.ts",
    "file:backfill-thumbnails": "ts-node -r tsconfig-paths/register src/scripts/backfill-file-thumbnails.ts",
    "order:dedupe-vouchers": "ts-node -r tsconfig-paths/register src/scripts/dedupe-order-vouchers.ts",
    "upload:files": "tsx src/scripts/upload-files-to-cloud.ts",
    "entity:gen": "./scripts/generate-modules.sh"
  },
  "keywords": [
    "express",
    "typescript",
    "typeorm",
    "inversify",
    "jwt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.16.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "croner": "^9.1.0",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "exceljs": "^3.4.0",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "fs-extra": "^11.3.3",
    "helmet": "^7.1.0",
    "inversify": "^6.0.2",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.3",
    "pgvector": "^0.2.1",
    "puppeteer": "^25.8.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.17",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "winston": "^3.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/puppeteer": "^5.4.7",
    "@types/web-push": "^3.6.4",
    "i": "^0.3.7",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "npm": "^11.5.2",
    "sqlite3": "^6.0.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.0",
    "typescript": "^5.3.2"
  },
  "_moduleAliases": {
    "@": "./src"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
